[Unit]
Description=MailAggregator token admin web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/var/lib/mailfetcher/secrets.env
ExecStart=/var/lib/mailfetcher/.venv/bin/python /usr/local/bin/mailfetcher.py --web --web-host 0.0.0.0 --web-port 9941 --web-base-url https://localhost /etc/mailfetcher/config.ini
Restart=always
RestartSec=5
User=mailfetcher
Group=mailfetcher

# Hardening (optional but nice)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mailfetcher

[Install]
WantedBy=multi-user.target
